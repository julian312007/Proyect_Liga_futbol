# Copia este archivo como ".env" (que NO se sube al repositorio) y ajusta los valores.
# Todos los valores de abajo son ficticios.
# Lo leen tanto "docker compose" como la aplicación (spring.config.import).

# ---- PostgreSQL ----
DB_HOST=localhost
# Cambia el puerto si ya tienes otro PostgreSQL local usando el 5432.
DB_PORT=5432
DB_NAME=liga
DB_USER=liga_user
DB_PASSWORD=cambia_esta_clave

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Servidor ----
SERVER_PORT=8080

# ---- Seguridad (Fase 1: ingreso con Google) ----
# Secreto de firma del JWT propio de la API (HS256). OBLIGATORIO: sin él la aplicación no arranca.
# Debe tener al menos 32 caracteres/bytes (256 bits) y se usa como texto (no como Base64).
# Va vacío a propósito: genera uno propio y NO lo compartas ni lo subas al repositorio. Por ejemplo:
#   Git Bash:    openssl rand -base64 48
#   PowerShell:  $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Vigencia del token propio en minutos (mayor que cero).
JWT_EXPIRATION_MINUTES=60
# ID de cliente de OAuth 2.0 de Google. OBLIGATORIO: sin él la aplicación no arranca.
# Cómo obtenerlo: Google Cloud Console (https://console.cloud.google.com) > crear o elegir un proyecto >
# APIs y servicios > Pantalla de consentimiento de OAuth (configurarla) > Credenciales > Crear credenciales >
# ID de cliente de OAuth > Tipo de aplicación: "Aplicación web" > en "Orígenes de JavaScript autorizados" agrega
# el origen de tu página (por ejemplo http://localhost:3000). Copia el "ID de cliente" (termina en
# .apps.googleusercontent.com). NO se necesita el "secreto del cliente": esta API no lo usa.
# El valor de abajo es solo un ejemplo ficticio y NO funciona: reemplázalo.
GOOGLE_CLIENT_ID=ejemplo-ficticio.apps.googleusercontent.com
# Correo de Google del administrador inicial. Se crea al arrancar (sin contraseña) y queda enlazado a su cuenta
# la primera vez que esa persona ingresa con Google. Déjalo vacío para no crear ninguno.
# example.com es un dominio reservado: nadie puede ingresar con ese correo. Pon aquí tu correo real de Google.
LIGA_ADMIN_EMAIL=admin@example.com
